# User uploads: serve as inert files only.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi

<IfModule mod_php.c>
  php_flag engine off
</IfModule>

<FilesMatch "\.(php|phtml|php[3-8]|phar|pl|py|cgi|sh|html?|shtml)$">
  Require all denied
</FilesMatch>

# An SVG opened directly must not run scripts on the platform's origin.
<IfModule mod_headers.c>
  Header set Content-Security-Policy "sandbox"
  Header set X-Content-Type-Options "nosniff"
</IfModule>
